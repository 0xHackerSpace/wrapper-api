@baseUrlGraphRAG=https://dev-graphrag.0xhackerspace.workers.dev
@graphId=COLE_AQUI_O_ID_RETORNADO_POR_POST_/v1/graphs
@sessionId=COLE_AQUI_O_ID_RETORNADO_POR_POST_/v1/sessions
@agentId=COLE_AQUI_O_ID_RETORNADO_POR_POST_/v1/agents
@teamId=COLE_AQUI_O_ID_RETORNADO_POR_POST_/v1/teams
@jwtToken=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..VA7SGv-bZ6Aw3uW0Ii3GJvtJnKDFLcRkiHzUtm2KODc

### ============================================
### AUTH WORKER
### ============================================

### Signup
POST {{baseUrlAuth}}/signup
Content-Type: application/json

{
  "username": "ianoliv",
  "email": "ian.oliv@outlook.com",
  "password": "password123"
}

### Login
POST {{baseUrlAuth}}/login
Content-Type: application/json

{
  "username": "ianoliv",
  "password": "password123"
}

### Logout
POST {{baseUrlAuth}}/logout
Authorization: Bearer {{jwtToken}}

### Get aggregate user stats (requires auth:stats permission, Admin only)
GET {{baseUrlAuth}}/stats
Authorization: Bearer {{jwtToken}}

### Get stats without a token (expect 401)
GET {{baseUrlAuth}}/stats

### Get stats with a valid token that lacks auth:stats (e.g. profile User, expect 403)
GET {{baseUrlAuth}}/stats
Authorization: Bearer token-de-usuario-sem-permissao-auth-stats

### ============================================
### INGREDIENTS API
### ============================================

### List all ingredients
GET {{baseUrlApi}}/ingredients
Authorization: Bearer {{jwtToken}}

### Get ingredient by ID
GET {{baseUrlApi}}/ingredients/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p
Authorization: Bearer {{jwtToken}}

### Create ingredient
POST {{baseUrlApi}}/ingredients
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "nome": "Alho",
  "slug": "alho",
  "type": "tempero",
  "reference": "https://en.wikipedia.org/wiki/Garlic",
  "url": "https://example.com/alho",
  "permissions": "public"
}

### Create ingredient (minimal - required fields only)
POST {{baseUrlApi}}/ingredients
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "nome": "Cebola",
  "slug": "cebola",
  "type": "vegetal"
}

### Update ingredient
PUT {{baseUrlApi}}/ingredients/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "nome": "Alho fresco",
  "reference": "https://pt.wikipedia.org/wiki/Alho"
}

### Delete ingredient
DELETE {{baseUrlApi}}/ingredients/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p
Authorization: Bearer {{jwtToken}}

### Get direct recommendations for an ingredient (graph neighbors, e.g. "pairs_well_with")
GET {{baseUrlApi}}/ingredients/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p/recommendations
Authorization: Bearer {{jwtToken}}

### Get direct recommendations filtered by relation
GET {{baseUrlApi}}/ingredients/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p/recommendations?relation=pairs_well_with
Authorization: Bearer {{jwtToken}}

### Get indirect recommendations (multi-hop traversal via graph-worker findPaths)
GET {{baseUrlApi}}/ingredients/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p/recommendations?indirect=true&maxDepth=3
Authorization: Bearer {{jwtToken}}

### Recommendations for an ingredient without a graph node yet (expect 200, empty list, not an error)
GET {{baseUrlApi}}/ingredients/2b3c4d5e-6f7g-8h9i-0j1k-2l3m4n5o6p7q/recommendations
Authorization: Bearer {{jwtToken}}

### Recommendations for an ingredient that doesn't exist (expect 404)
GET {{baseUrlApi}}/ingredients/00000000-0000-0000-0000-000000000000/recommendations
Authorization: Bearer {{jwtToken}}

### ============================================
### RAG WORKER
### ============================================

### Query RAG
POST {{baseUrlRag}}/query
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "question": "Como preparar alho?",
  "topK": 5
}

### Ingest content (default graphId "rag-documents" for automatic entity/relation enrichment)
POST {{baseUrlRag}}/ingest
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "text": "Alho é um tempero versátil usado em muitas culinárias...",
  "source": "wikipedia",
  "metadata": {
    "type": "ingredient"
  }
}

### Ingest content with an explicit graphId (routes automatic enrichment to a different graph)
POST {{baseUrlRag}}/ingest
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "text": "Alho combina bem com azeite, limão e ervas frescas em receitas mediterrâneas.",
  "source": "wikipedia",
  "graphId": "ingredients",
  "metadata": {
    "type": "ingredient"
  }
}

### ============================================
### AI WORKER (OpenAI-compatible)
### ============================================

### List available models (public, no auth required)
GET {{baseUrlAI}}/v1/models

### Chat completion (with system instruction, requires ai:chat permission, Admin only)
POST {{baseUrlAI}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "model": "@cf/mistral/mistral-7b-instruct-v0.1",
  "messages": [
    {
      "role": "system",
      "content": "Você é um assistente útil e amigável que responde perguntas de forma clara e concisa.me responda apenas em português."
    },
    {
      "role": "user",
      "content": "qual a capital da França?"
    }
  ],
  "temperature": 0.7,
  "max_tokens": 512
}

### Chat completion (minimal, requires ai:chat permission, Admin only)
POST {{baseUrlAI}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "messages": [
    {
      "role": "user",
      "content": "Explique como fazer uma receita de alho"
    }
  ]
}

### Chat completion with streaming (stream: true, returns text/event-stream chat.completion.chunk events, requires ai:chat permission)
POST {{baseUrlAI}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "messages": [
    {
      "role": "user",
      "content": "Explique como fazer uma receita de alho"
    }
  ],
  "stream": true
}

### Chat completion without a token (expect 401)
POST {{baseUrlAI}}/v1/chat/completions
Content-Type: application/json

{
  "messages": [
    {
      "role": "user",
      "content": "Explique como fazer uma receita de alho"
    }
  ]
}

### Chat completion with a valid token that lacks ai:chat (e.g. profile User, expect 403)
POST {{baseUrlAI}}/v1/chat/completions
Content-Type: application/json
Authorization: Bearer token-de-usuario-sem-permissao-ai-chat

{
  "messages": [
    {
      "role": "user",
      "content": "Explique como fazer uma receita de alho"
    }
  ]
}

### --- Sessões de chat (ai:chat, acesso via chat_access: owner/editor/viewer) ---

### Create a chat session (empty, title: null, creator becomes owner)
POST {{baseUrlAI}}/v1/sessions
Authorization: Bearer {{jwtToken}}

### Create a chat session bound to an agent (agent_id optional; requires viewer+ in agent_access, config is snapshotted at creation time, ADR 0022)
POST {{baseUrlAI}}/v1/sessions
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "agent_id": "{{agentId}}"
}

### List sessions the authenticated user has chat_access to, paginated (ordered by updated_at desc)
GET {{baseUrlAI}}/v1/sessions?limit=20
Authorization: Bearer {{jwtToken}}

### List sessions, next page (cursor copiado do next_cursor da resposta anterior)
GET {{baseUrlAI}}/v1/sessions?limit=20&cursor=COLE_AQUI_O_NEXT_CURSOR
Authorization: Bearer {{jwtToken}}

### Get session metadata + caller's role (no messages inline; 404 if it doesn't exist or you have no access)
GET {{baseUrlAI}}/v1/sessions/{{sessionId}}
Authorization: Bearer {{jwtToken}}

### Rename a session (requires editor/owner role)
PATCH {{baseUrlAI}}/v1/sessions/{{sessionId}}
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "title": "Receitas com alho"
}

### Send a message in a session (persists user+assistant turn, title auto-filled on first message, requires editor/owner)
POST {{baseUrlAI}}/v1/sessions/{{sessionId}}/messages
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "content": "Explique como fazer uma receita de alho",
  "model": "@cf/mistral/mistral-7b-instruct-v0.1"
}

### Send a message with streaming (stream: true; returns SSE chat.completion.chunk events, assistant message is only persisted after the stream ends successfully, requires editor/owner)
POST {{baseUrlAI}}/v1/sessions/{{sessionId}}/messages
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "content": "Explique como fazer uma receita de alho",
  "model": "@cf/mistral/mistral-7b-instruct-v0.1",
  "stream": true
}

### Send a message in a session created with agent_id pointing at a tool-calling agent (see the
### "Create an agent with tool calling enabled" example above). The response's `message.content`
### is the final assistant answer, but the model->tool->model cycles it took to get there are also
### persisted in chat_messages as extra role: "assistant" (tool_calls) / role: "tool" (result) rows --
### visible via GET .../messages, invisible in this response. Works the same with stream: true, which
### only re-streams the already-computed final answer (docs/decisions/0023-agent-tool-calling.md).
POST {{baseUrlAI}}/v1/sessions/{{sessionId}}/messages
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "content": "O que a nossa base de conhecimento diz sobre substituir alho por alho em pó?"
}

### List message history, paginated (ordered by created_at asc, requires viewer+)
GET {{baseUrlAI}}/v1/sessions/{{sessionId}}/messages?limit=20
Authorization: Bearer {{jwtToken}}

### List message history, next page
GET {{baseUrlAI}}/v1/sessions/{{sessionId}}/messages?limit=20&cursor=COLE_AQUI_O_NEXT_CURSOR
Authorization: Bearer {{jwtToken}}

### Delete a session (cascades to its messages and chat_access, requires owner)
DELETE {{baseUrlAI}}/v1/sessions/{{sessionId}}
Authorization: Bearer {{jwtToken}}

### --- Collaborators (chat_access: owner/editor/viewer, mesmo modelo do graph-worker) ---

### Grant/update a collaborator's role (upsert, owner-only)
PUT {{baseUrlAI}}/v1/sessions/{{sessionId}}/access/00000000-0000-0000-0000-00000000userB
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "role": "editor"
}

### List collaborators of the session (any role, viewer+)
GET {{baseUrlAI}}/v1/sessions/{{sessionId}}/access
Authorization: Bearer {{jwtToken}}

### Remove a collaborator's access (owner-only when it's someone else)
DELETE {{baseUrlAI}}/v1/sessions/{{sessionId}}/access/00000000-0000-0000-0000-00000000userB
Authorization: Bearer {{jwtToken}}

### Leave a session yourself (self-removal, any role, no owner check)
DELETE {{baseUrlAI}}/v1/sessions/{{sessionId}}/access/00000000-0000-0000-0000-00000000userA
Authorization: Bearer {{jwtToken}}

### viewer trying to send a message (expect 403, not 404 -- they already know the session exists)
POST {{baseUrlAI}}/v1/sessions/{{sessionId}}/messages
Content-Type: application/json
Authorization: Bearer token-de-usuario-viewer-nesta-sessao

{
  "content": "Explique como fazer uma receita de alho"
}

### Downgrading or removing the sole owner of the session (expect 409, "Session must have at least one owner")
PUT {{baseUrlAI}}/v1/sessions/{{sessionId}}/access/00000000-0000-0000-0000-00000000userA
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "role": "viewer"
}

### Session that doesn't exist or you have no chat_access to (expect 404)
GET {{baseUrlAI}}/v1/sessions/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{jwtToken}}

### --- Agents (ai:agents, config de IA reutilizavel, acesso via agent_access: owner/editor/viewer) ---

### Create an agent (creator becomes owner)
POST {{baseUrlAI}}/v1/agents
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "name": "Assistente de receitas",
  "system_prompt": "Você é um assistente útil e amigável que responde perguntas sobre culinária de forma clara e concisa, sempre em português.",
  "model": "@cf/mistral/mistral-7b-instruct-v0.1",
  "temperature": 0.7,
  "max_tokens": 512
}

### Create an agent with tool calling enabled (docs/decisions/0023-agent-tool-calling.md) -- tools
### is validated against the ai-worker's fixed tool catalog (400 for unknown names), and needs a
### model with confirmed function-calling support (@cf/meta/llama-3.1-8b-instruct)
POST {{baseUrlAI}}/v1/agents
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "name": "Assistente com busca na base de conhecimento",
  "system_prompt": "Você é um assistente que consulta a base de conhecimento (RAG) sempre que precisar de informação factual antes de responder, sempre em português.",
  "model": "@cf/meta/llama-3.1-8b-instruct",
  "temperature": 0.7,
  "tools": ["query_knowledge_base"],
  "max_tool_iterations": 5
}

### Create an agent with the find_node tool enabled (docs/decisions/0024-agent-graph-tool.md) -- graph_id
### is not validated at registration time (no existence/access check); find_node does an exact
### (type, label) lookup in that graph at runtime, using the real sending user's sub as actorSub
### for the graph-worker's ACL check (403 from graph-worker becomes a tool error, not a failed request)
POST {{baseUrlAI}}/v1/agents
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "name": "Assistente com busca no grafo de conhecimento",
  "system_prompt": "Você é um assistente que consulta o grafo de conhecimento para encontrar nodes específicos (ex.: ingredientes, receitas) antes de responder, sempre em português.",
  "model": "@cf/meta/llama-3.1-8b-instruct",
  "temperature": 0.7,
  "tools": ["find_node"],
  "max_tool_iterations": 5,
  "graph_id": "ingredients"
}

### List agents the authenticated user has agent_access to, paginated (ordered by updated_at desc)
GET {{baseUrlAI}}/v1/agents?limit=20
Authorization: Bearer {{jwtToken}}

### List agents, next page (cursor copiado do next_cursor da resposta anterior)
GET {{baseUrlAI}}/v1/agents?limit=20&cursor=COLE_AQUI_O_NEXT_CURSOR
Authorization: Bearer {{jwtToken}}

### Get agent detail + caller's role (404 if it doesn't exist or you have no access)
GET {{baseUrlAI}}/v1/agents/{{agentId}}
Authorization: Bearer {{jwtToken}}

### Update an agent's fields (requires editor/owner role)
PATCH {{baseUrlAI}}/v1/agents/{{agentId}}
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "system_prompt": "Você é um assistente útil e amigável, especialista em culinária mediterrânea, sempre em português.",
  "temperature": 0.5
}

### Delete an agent (requires owner; existing sessions keep their snapshot, unaffected)
DELETE {{baseUrlAI}}/v1/agents/{{agentId}}
Authorization: Bearer {{jwtToken}}

### --- Collaborators (agent_access: owner/editor/viewer, mesmo modelo do graph-worker/chat) ---

### Grant/update a collaborator's role (upsert, owner-only)
PUT {{baseUrlAI}}/v1/agents/{{agentId}}/access/00000000-0000-0000-0000-00000000userB
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "role": "editor"
}

### List collaborators of the agent (any role, viewer+)
GET {{baseUrlAI}}/v1/agents/{{agentId}}/access
Authorization: Bearer {{jwtToken}}

### Remove a collaborator's access (owner-only when it's someone else)
DELETE {{baseUrlAI}}/v1/agents/{{agentId}}/access/00000000-0000-0000-0000-00000000userB
Authorization: Bearer {{jwtToken}}

### Leave an agent yourself (self-removal, any role, no owner check)
DELETE {{baseUrlAI}}/v1/agents/{{agentId}}/access/00000000-0000-0000-0000-00000000userA
Authorization: Bearer {{jwtToken}}

### viewer trying to PATCH an agent (expect 403, not 404 -- they already know the agent exists)
PATCH {{baseUrlAI}}/v1/agents/{{agentId}}
Content-Type: application/json
Authorization: Bearer token-de-usuario-viewer-neste-agent

{
  "name": "Tentativa de edição"
}

### Downgrading or removing the sole owner of the agent (expect 409, "Agent must have at least one owner")
PUT {{baseUrlAI}}/v1/agents/{{agentId}}/access/00000000-0000-0000-0000-00000000userA
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "role": "viewer"
}

### Agent that doesn't exist or you have no agent_access to (expect 404)
GET {{baseUrlAI}}/v1/agents/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{jwtToken}}

### Creating an agent or listing agents with a valid token that lacks ai:agents (e.g. profile User, expect 403)
POST {{baseUrlAI}}/v1/agents
Content-Type: application/json
Authorization: Bearer token-de-usuario-sem-permissao-ai-agents

{
  "name": "Assistente de receitas",
  "system_prompt": "Você é um assistente útil.",
  "model": "@cf/mistral/mistral-7b-instruct-v0.1"
}

### Creating a session with an agent_id you have no access to (expect 404, not 403 -- non-leaking semantics)
POST {{baseUrlAI}}/v1/sessions
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "agent_id": "00000000-0000-0000-0000-000000000000"
}

### --- Teams (ai:teams, orquestracao multi-agent, acesso via team_access: owner/editor/viewer) ---
### Crie ao menos 2-3 agents primeiro (ver secao Agents acima) para usar como members abaixo.

### Create a team with orchestration_mode "pipeline" -- members run in order_index order,
### each one gets only the original user message + the previous member's output (docs/decisions/0025-agent-teams.md)
POST {{baseUrlAI}}/v1/teams
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "name": "Pipeline de revisao de receitas",
  "orchestration_mode": "pipeline",
  "members": [
    { "agent_id": "{{agentId}}", "order_index": 0 }
  ]
}

### Create a team with orchestration_mode "debate" -- all members see the discussion so far and
### speak in order each round; lead_agent_id is the moderator/synthesizer, rounds is always the
### safety ceiling regardless of termination_strategy (docs/decisions/0025-agent-teams.md)
POST {{baseUrlAI}}/v1/teams
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "name": "Debate de receitas",
  "orchestration_mode": "debate",
  "members": [
    { "agent_id": "{{agentId}}", "order_index": 0 }
  ],
  "lead_agent_id": "{{agentId}}",
  "rounds": 3,
  "termination_strategy": "moderator"
}

### Create a team with orchestration_mode "orchestrator" -- lead_agent_id decides, step by step,
### which other member speaks next (or finishes) via the synthetic select_next_agent tool;
### max_orchestrator_steps is the safety ceiling (default 10, docs/decisions/0025-agent-teams.md)
POST {{baseUrlAI}}/v1/teams
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "name": "Coordenador de receitas",
  "orchestration_mode": "orchestrator",
  "members": [
    { "agent_id": "{{agentId}}", "order_index": 0 }
  ],
  "lead_agent_id": "{{agentId}}",
  "max_orchestrator_steps": 10
}

### List teams the authenticated user has team_access to, paginated (ordered by updated_at desc)
GET {{baseUrlAI}}/v1/teams?limit=20
Authorization: Bearer {{jwtToken}}

### Get team detail + ordered members list + caller's role (404 if it doesn't exist or you have no access)
GET {{baseUrlAI}}/v1/teams/{{teamId}}
Authorization: Bearer {{jwtToken}}

### Update a team's fields (requires editor/owner role) -- sending members replaces the whole list
PATCH {{baseUrlAI}}/v1/teams/{{teamId}}
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "rounds": 5
}

### Delete a team (requires owner; does not delete the member agents)
DELETE {{baseUrlAI}}/v1/teams/{{teamId}}
Authorization: Bearer {{jwtToken}}

### --- Collaborators (team_access: owner/editor/viewer, mesmo modelo do graph-worker/chat/agents) ---

### Grant/update a collaborator's role (upsert, owner-only)
PUT {{baseUrlAI}}/v1/teams/{{teamId}}/access/00000000-0000-0000-0000-00000000userB
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "role": "editor"
}

### List collaborators of the team (any role, viewer+)
GET {{baseUrlAI}}/v1/teams/{{teamId}}/access
Authorization: Bearer {{jwtToken}}

### Remove a collaborator's access (owner-only when it's someone else)
DELETE {{baseUrlAI}}/v1/teams/{{teamId}}/access/00000000-0000-0000-0000-00000000userB
Authorization: Bearer {{jwtToken}}

### Creating a team or listing teams with a valid token that lacks ai:teams (e.g. profile User, expect 403)
POST {{baseUrlAI}}/v1/teams
Content-Type: application/json
Authorization: Bearer token-de-usuario-sem-permissao-ai-teams

{
  "name": "Pipeline de revisao de receitas",
  "orchestration_mode": "pipeline",
  "members": [
    { "agent_id": "{{agentId}}", "order_index": 0 }
  ]
}

### Create a chat session bound to a team instead of a single agent (team_id optional; mutually
### exclusive with agent_id, 400 if both are sent; requires viewer+ in team_access; NO snapshot --
### team_id is a live reference, so editing the team afterwards changes the next message's behavior,
### docs/decisions/0025-agent-teams.md)
POST {{baseUrlAI}}/v1/sessions
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "team_id": "{{teamId}}"
}

### Sending agent_id and team_id together in POST /v1/sessions (expect 400, mutually exclusive)
POST {{baseUrlAI}}/v1/sessions
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "agent_id": "{{agentId}}",
  "team_id": "{{teamId}}"
}

### ============================================
### GRAPH WORKER (knowledge graph)
### ============================================

### Health check
GET {{baseUrlGraph}}/health

### --- Grafos (containers isolados) ---

### Create a graph (creator automatically becomes owner)
POST {{baseUrlGraph}}/v1/graphs
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "name": "Ingredientes"
}

### List graphs the caller has access to (owner/editor/viewer)
GET {{baseUrlGraph}}/v1/graphs
Authorization: Bearer {{jwtToken}}

### --- Nodes e edges (sempre dentro de um grafo) ---
### Copie o "id" retornado por POST /v1/graphs para @graphId no topo do arquivo

### Create node (entity)
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "type": "ingredient",
  "label": "Alho",
  "properties": {
    "origin": "Ásia Central"
  },
  "source_document_id": "doc-alho-001"
}

### Create another node (to link as neighbor)
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "type": "ingredient",
  "label": "Cebola",
  "properties": {
    "origin": "Ásia Central"
  }
}
### Create another node (to link as neighbor)
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "type": "ingredient",
  "label": "queijo suico",
  "properties": {
    "origin": "Europa"
  }
}

### Get node by ID
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p
Authorization: Bearer {{jwtToken}}

### List nodes by type
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes?type=ingredient
Authorization: Bearer {{jwtToken}}

### List nodes by type and label (case-insensitive filter)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes?type=ingredient&label=Alho
Authorization: Bearer {{jwtToken}}

### Update a node's label/properties
PUT {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "label": "Alho (fresco)",
  "properties": {
    "origin": "Ásia Central",
    "notes": "atualizado após colheita"
  }
}

### Delete a node (cascades to its edges)
DELETE {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p
Authorization: Bearer {{jwtToken}}

### Create edge (relation between two nodes)
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/edges
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "from_node_id": "1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p",
  "to_node_id": "2b3c4d5e-6f7g-8h9i-0j1k-2l3m4n5o6p7q",
  "relation": "combines_with",
  "properties": {
    "context": "receitas de tempero"
  }
}

### List neighbors of a node
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/0aba4e07-e3ee-4b50-abd2-dd1f6a32e834/neighbors
Authorization: Bearer {{jwtToken}}

### List neighbors filtered by relation and node type
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/0aba4e07-e3ee-4b50-abd2-dd1f6a32e834/neighbors?relation=combines_with&type=ingredient
Authorization: Bearer {{jwtToken}}

### Check direct relations between two nodes
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p/relations?to=2b3c4d5e-6f7g-8h9i-0j1k-2l3m4n5o6p7q
Authorization: Bearer {{jwtToken}}

### --- Travessia multi-hop (paths) ---

### All nodes reachable from a given node (no "to", default maxDepth=3)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/0aba4e07-e3ee-4b50-abd2-dd1f6a32e834/paths
Authorization: Bearer {{jwtToken}}

### Paths between two specific nodes, up to 4 hops
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/0aba4e07-e3ee-4b50-abd2-dd1f6a32e834/paths?to=node-cebolinha&maxDepth=4
Authorization: Bearer {{jwtToken}}

### Paths filtered by relation and direction (only "combines_with" edges, outgoing)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/0aba4e07-e3ee-4b50-abd2-dd1f6a32e834/paths?relation=combines_with&direction=outgoing
Authorization: Bearer {{jwtToken}}

### maxDepth above the allowed range gets clamped to 6 (no error)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/0aba4e07-e3ee-4b50-abd2-dd1f6a32e834/paths?maxDepth=99
Authorization: Bearer {{jwtToken}}

### "to" node that doesn't exist in this graph (expect 404)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/0aba4e07-e3ee-4b50-abd2-dd1f6a32e834/paths?to=00000000-0000-0000-0000-000000000000
Authorization: Bearer {{jwtToken}}

### --- Mais casos de uso ---

### Create node with client-supplied id
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "id": "node-cebolinha",
  "type": "ingredient",
  "label": "Cebolinha",
  "properties": {
    "origin": "América do Sul"
  }
}

### Build a small graph: third node + second edge (Alho -[substitui]-> Cebolinha)
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/edges
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "from_node_id": "0aba4e07-e3ee-4b50-abd2-dd1f6a32e834",
  "to_node_id": "node-cebolinha",
  "relation": "substitui",
  "properties": {
    "context": "quando alho não está disponível"
  }
}

### List neighbors after multiple edges (should include Cebola + Cebolinha, each with sua relation)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/0aba4e07-e3ee-4b50-abd2-dd1f6a32e834/neighbors
Authorization: Bearer {{jwtToken}}

### Node from a RAG-ingested document (source_document_id linka de volta ao rag-worker)
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "type": "concept",
  "label": "Culinária mediterrânea",
  "source_document_id": "doc-alho-001"
}

### List nodes by type "concept"
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes?type=concept
Authorization: Bearer {{jwtToken}}

### --- Collaborators (graph_access: owner/editor/viewer) ---

### Grant/update a collaborator's role (upsert, owner-only, requires graph:write)
PUT {{baseUrlGraph}}/v1/graphs/{{graphId}}/access/00000000-0000-0000-0000-00000000userB
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "role": "editor"
}

### List collaborators of the graph (any role, viewer+, requires graph:read)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/access
Authorization: Bearer {{jwtToken}}

### Remove a collaborator's access (owner-only when it's someone else, requires graph:write)
DELETE {{baseUrlGraph}}/v1/graphs/{{graphId}}/access/00000000-0000-0000-0000-00000000userB
Authorization: Bearer {{jwtToken}}

### Leave a graph yourself (self-removal, only requires graph:read, no owner check)
DELETE {{baseUrlGraph}}/v1/graphs/{{graphId}}/access/00000000-0000-0000-0000-00000000userA
Authorization: Bearer {{jwtToken}}

### Grant/revoke access to someone else as a non-owner (expect 403)
PUT {{baseUrlGraph}}/v1/graphs/{{graphId}}/access/00000000-0000-0000-0000-00000000userB
Content-Type: application/json
Authorization: Bearer token-de-usuario-editor-ou-viewer-no-grafo

{
  "role": "viewer"
}

### Downgrading or removing the sole owner of the graph (expect 409, "Graph must have at least one owner")
PUT {{baseUrlGraph}}/v1/graphs/{{graphId}}/access/00000000-0000-0000-0000-00000000userA
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "role": "viewer"
}

### --- Casos de erro ---

### Missing auth token on a protected route (expect 401)
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes
Content-Type: application/json

{
  "type": "ingredient",
  "label": "Sal"
}

### Invalid/expired token (expect 401)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes?type=ingredient
Authorization: Bearer token-invalido

### Create node without required field "label" (expect 400, ValidationError)
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "type": "ingredient"
}

### List nodes without required "type" query param (expect 400)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes
Authorization: Bearer {{jwtToken}}

### Get a node that doesn't exist (expect 404)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{jwtToken}}

### Create edge pointing to a node that doesn't exist (expect 400, ValidationError)
POST {{baseUrlGraph}}/v1/graphs/{{graphId}}/edges
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "from_node_id": "1a2b3c4d-5e6f-7g8h-9i0j-1k2l3m4n5o6p",
  "to_node_id": "00000000-0000-0000-0000-000000000000",
  "relation": "related_to"
}

### Neighbors of a node with no relations (expect empty list)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/node-cebolinha/neighbors
Authorization: Bearer {{jwtToken}}

### Relations between two nodes that aren't directly connected (expect empty/none)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes/node-cebolinha/relations?to=00000000-0000-0000-0000-000000000000
Authorization: Bearer {{jwtToken}}

### Request to a graph id that doesn't exist at all (expect 404)
GET {{baseUrlGraph}}/v1/graphs/grafo-que-nao-existe/nodes?type=ingredient
Authorization: Bearer {{jwtToken}}

### Request to a graph that exists but you have no access to (expect 403)
### Use um @graphId real que pertença a outro usuário (crie um grafo com outro jwtToken/sub)
GET {{baseUrlGraph}}/v1/graphs/{{graphId}}/nodes?type=ingredient
Authorization: Bearer token-de-usuario-sem-acesso-a-esse-grafo

### Unknown route on graph worker (expect 404)
GET {{baseUrlGraph}}/v1/unknown

### ============================================
### GRAPHRAG WORKER (Q&A híbrido: RAG + Graph)
### ============================================

### Health check (reporta quais dos 3 bindings - rag/graph/ai - estão configurados)
GET {{baseUrlGraphRAG}}/health

### Hybrid Q&A over the "ingredients" graph (entities from api-worker's recommendation graph, ADR 0016)
POST {{baseUrlGraphRAG}}/v1/graphrag/query
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "question": "Com que ingredientes o alho combina bem?",
  "graphId": "ingredients",
  "topK": 5,
  "maxDepth": 2
}

### Hybrid Q&A over the default "rag-documents" graph (entities enriched automatically from /ingest, ADR 0016)
POST {{baseUrlGraphRAG}}/v1/graphrag/query
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "question": "Como o alho é usado na culinária mediterrânea?"
}

### Question with no entities found in the graph (expect 200, graphContext empty, answer based only on vector context)
POST {{baseUrlGraphRAG}}/v1/graphrag/query
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "question": "Qual a capital da França?"
}

### Missing/empty "question" field (expect 400, ValidationError)
POST {{baseUrlGraphRAG}}/v1/graphrag/query
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "graphId": "ingredients"
}

### Query without a token (expect 401)
POST {{baseUrlGraphRAG}}/v1/graphrag/query
Content-Type: application/json

{
  "question": "Com que ingredientes o alho combina bem?"
}

### Query with a valid token that lacks graphrag:query (e.g. profile User, expect 403)
POST {{baseUrlGraphRAG}}/v1/graphrag/query
Content-Type: application/json
Authorization: Bearer token-de-usuario-sem-permissao-graphrag-query

{
  "question": "Com que ingredientes o alho combina bem?"
}

### ============================================
### NOTES
### ============================================

### Para usar:
### 1. Instale a extensão "REST Client" no VS Code (humao.rest-client)
### 2. Copie o JWT token retornado pelo /login para a variável @jwtToken acima
### 3. Clique em "Send Request" acima de cada requisição
### 4. Ou use Ctrl+Alt+R (Windows/Linux) ou Cmd+Alt+R (Mac)

### Exemplo de resposta de login:
### {
###   "access_token": "eyJhbGc...",
###   "token_type": "Bearer",
###   "expires_in": 3600,
###   "permissions": ["api:access", "rag:query"],
###   "profiles": ["User"]
### }
