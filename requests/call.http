@baseUrlAuth=https://dev-auth.0xhackerspace.workers.dev
@baseUrlApi=https://dev-api.0xhackerspace.workers.dev
@baseUrlRag=https://dev-rag.0xhackerspace.workers.dev
@baseUrlAI=https://dev-ai.0xhackerspace.workers.dev
